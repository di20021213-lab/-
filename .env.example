# Скопируйте в .env и подставьте своё. Без SMTP письма не пропадают:
# они складываются в var/mail/*.eml, а ссылка печатается в консоль.

PORT=3000
# На каком адресе слушать. 0.0.0.0 — видно из локальной сети, 127.0.0.1 — только этот компьютер.
HOST=0.0.0.0
# Адрес, по которому игру видно снаружи. Из него собираются ссылки в письмах.
PUBLIC_URL=http://localhost:3000
# Файл базы. По умолчанию var/kolhoz.db
DB_PATH=var/kolhoz.db

# Требовать подтверждение почты. Выключайте, только если играете в своей сети
# и почтового сервера нет: тогда после регистрации сразу пускает в игру.
REQUIRE_EMAIL_VERIFY=true

# ------------------------------------------------------------------ почта
# Пока SMTP_HOST пуст, письма никуда не уходят: они складываются в
# var/mail/*.eml, а код и ссылка печатаются в консоль. Для разработки этого
# достаточно, для живой игры — нет.
#
# Обычный пароль от ящика сюда вписывать нельзя, его не примут: почтовые
# службы требуют отдельный пароль для приложений. Заводится он в настройках
# самого ящика, и его в любой момент можно отозвать, не меняя основной.
#
#   Gmail      SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  SMTP_SECURE=false
#              Пароль: Аккаунт Google → Безопасность → Пароли приложений.
#              Пункт появляется, только если включена двухэтапная проверка.
#   Яндекс     SMTP_HOST=smtp.yandex.ru      SMTP_PORT=465  SMTP_SECURE=true
#              Пароль: Яндекс ID → Безопасность → Пароли приложений → Почта.
#              Плюс в настройках почты надо разрешить доступ по SMTP.
#   Mail.ru    SMTP_HOST=smtp.mail.ru        SMTP_PORT=465  SMTP_SECURE=true
#              Пароль: Почта → Безопасность → Пароли для внешних приложений.
#
# SMTP_SECURE=true для порта 465, false для 587 — это не про надёжность,
# а про то, шифруется ли соединение сразу или после команды STARTTLS.
# SMTP_USER — полный адрес ящика целиком, вместе с доменом.
# MAIL_FROM — что увидит игрок в поле «От кого». Адрес в угловых скобках
# должен совпадать с ящиком, иначе служба либо подменит его, либо
# отправит письмо в спам.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Колхоз «Червонэ дышло» <noreply@example.org>
