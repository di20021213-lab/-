# === Секреты Telegram (обязательно) ===
# Токен бота, который выдаёт @BotFather после /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Твой chat_id, куда слать уведомления.
# Узнать: запусти  python get_chat_id.py  и напиши что-нибудь своему боту.
TELEGRAM_CHAT_ID=123456789

# === Необязательно ===
# Прокси. Рекомендуется российский IP — Авито нормально открывается из РФ.
# Форматы: http://host:port  или  http://user:pass@host:port  или  socks5://host:port
# PROXY=http://user:pass@host:port

# Путь к файлу базы «виденных» объявлений (по умолчанию seen.sqlite3)
# DB_PATH=seen.sqlite3

# Показывать окно браузера (для отладки). По умолчанию false (headless).
# HEADLESS=false

# Путь к готовому браузеру Chromium (если не хочешь, чтобы Playwright качал свой).
# Обычно НЕ нужен: достаточно `playwright install chromium`.
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
