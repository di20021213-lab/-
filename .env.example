# === Секреты Telegram (обязательно) ===
# Токен бота, который выдаёт @BotFather после /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Твой chat_id, куда слать уведомления.
# Узнать: запусти  python get_chat_id.py  и напиши что-нибудь своему боту.
TELEGRAM_CHAT_ID=123456789

# === Необязательно ===
# База Telegram Bot API. Нужна, если api.telegram.org недоступен (блокировки) и ты
# ходишь через Bot API-прокси или локальный сервер. По умолчанию https://api.telegram.org
# TELEGRAM_API_BASE=https://api.telegram.org

# Прокси для АВИТО. Нужен, только если Авито НЕ открывается напрямую
# (запускаешь с зарубежного IP/VPS). Если ты в РФ — оставь пустым: свой
# домашний/мобильный IP для антибота лучше, чем датацентровый прокси.
# Форматы: http://host:port  или  http://user:pass@host:port  или  socks5://host:port
# PROXY=http://user:pass@host:port

# Прокси ТОЛЬКО для Telegram. Обратный случай: ты в РФ, Авито открывается
# напрямую, а api.telegram.org — нет. Тогда задай здесь зарубежный прокси,
# а PROXY выше оставь пустым. Если не задан — берётся PROXY.
# Для socks5 нужен пакет PySocks (ставится через requests[socks] из requirements.txt).
# ВНИМАНИЕ: MTproto-прокси СЮДА НЕ ПОДХОДИТ — он только для приложения Telegram,
# а бот ходит в Bot API по HTTPS. Нужен обычный HTTP/SOCKS5 прокси.
# TELEGRAM_PROXY=http://user:pass@host:port

# Путь к файлу базы «виденных» объявлений (по умолчанию seen.sqlite3)
# DB_PATH=seen.sqlite3

# Показывать окно браузера (для отладки). По умолчанию false (headless).
# HEADLESS=false

# Путь к готовому браузеру Chromium (если не хочешь, чтобы Playwright качал свой).
# Обычно НЕ нужен: достаточно `playwright install chromium`.
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
